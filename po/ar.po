#: src/ui/main_window.rs
msgid "Light"
msgstr "فاتح"

#: src/ui/main_window.rs
msgid "Dark"
msgstr "داكن"

#. Dashboard page
#: src/ui/dashboard_page.rs
msgid "Safe and transparent system cleaning"
msgstr "تنظيف النظام الآمن والشفاف"

#: src/ui/dashboard_page.rs
msgid "Reclaimable Space"
msgstr "المساحة القابلة للاستعادة"

#: src/ui/dashboard_page.rs
msgid "Enabled Targets"
msgstr "الأهداف المُفعّلة"

#: src/ui/dashboard_page.rs
msgid "Last Cleanup"
msgstr "آخر تنظيف"

#: src/ui/dashboard_page.rs
msgid "Never"
msgstr "أبداً"

#: src/ui/dashboard_page.rs
msgid "Start Cleanup"
msgstr "بدء التنظيف"

#: src/ui/dashboard_page.rs
msgid "Scan and clean enabled targets. You'll see a preview before anything is deleted."
msgstr "فحص وتنظيف الأهداف المُفعّلة. سترى معاينة قبل حذف أي شيء."

#: src/ui/dashboard_page.rs
msgid "Scan for Files"
msgstr "فحص الملفات"

#: src/ui/dashboard_page.rs
msgid "Clean Now"
msgstr "تنظيف الآن"

#: src/ui/dashboard_page.rs
msgid "Scanning..."
msgstr "جارٍ الفحص..."

#: src/ui/dashboard_page.rs
msgid "Click 'Scan' to check"
msgstr "انقر 'فحص' للتحقق"

#. Browsers page
#: src/ui/browsers_page.rs
msgid "Browser Cleanup"
msgstr "تنظيف المتصفح"

#: src/ui/browsers_page.rs
msgid "Select which browser data to clean. Cache is safe to delete, but cookies and history are permanent."
msgstr "اختر بيانات المتصفح للتنظيف. الذاكرة المؤقتة آمنة للحذف، لكن ملفات تعريف الارتباط والسجل دائمة."

#: src/ui/browsers_page.rs
msgid "Installed"
msgstr "مثبت"

#: src/ui/browsers_page.rs
msgid "Not detected"
msgstr "غير مكتشف"

#. Browser data types
#: src/ui/browsers_page.rs
msgid "Cache"
msgstr "الذاكرة المؤقتة"

#: src/ui/browsers_page.rs
msgid "Cookies"
msgstr "ملفات تعريف الارتباط"

#: src/ui/browsers_page.rs
msgid "History"
msgstr "السجل"

#: src/ui/browsers_page.rs
msgid "Sessions"
msgstr "الجلسات"

#. Applications page
#: src/ui/applications_page.rs
msgid "Application Caches"
msgstr "ذاكرة التطبيقات المؤقتة"

#: src/ui/applications_page.rs
msgid "Clean caches from package managers and applications. These are safe to delete but may slow down first runs."
msgstr "تنظيف الذاكرة المؤقتة من مديري الحزم والتطبيقات. هذه آمنة للحذف لكنها قد تبطئ التشغيل الأول."

#. System page
#: src/ui/system_page.rs
msgid "System Cleanup"
msgstr "تنظيف النظام"

#: src/ui/system_page.rs
msgid "Clean system-level temporary files and caches. Some options require administrator privileges."
msgstr "تنظيف الملفات المؤقتة والذاكرة المؤقتة على مستوى النظام. بعض الخيارات تتطلب صلاحيات المسؤول."

#. Settings page
#: src/ui/settings_page.rs
msgid "General"
msgstr "عام"

#: src/ui/settings_page.rs
msgid "Confirm Before Cleaning"
msgstr "تأكيد قبل التنظيف"

#: src/ui/settings_page.rs
msgid "Show a confirmation dialog before deleting files"
msgstr "عرض مربع حوار تأكيد قبل حذف الملفات"

#: src/ui/settings_page.rs
msgid "Show Cleanup Summary"
msgstr "عرض ملخص التنظيف"

#: src/ui/settings_page.rs
msgid "Display a summary after cleaning completes"
msgstr "عرض ملخص بعد اكتمال التنظيف"

#: src/ui/settings_page.rs
msgid "Safety"
msgstr "الأمان"

#: src/ui/settings_page.rs
msgid "These settings help prevent accidental data loss"
msgstr "هذه الإعدادات تساعد في منع فقدان البيانات العرضي"

#: src/ui/settings_page.rs
msgid "Maximum Files Per Operation"
msgstr "الحد الأقصى للملفات لكل عملية"

#: src/ui/settings_page.rs
msgid "Stop after deleting this many files"
msgstr "التوقف بعد حذف هذا العدد من الملفات"

#: src/ui/settings_page.rs
msgid "Follow Symlinks"
msgstr "تتبع الروابط الرمزية"

#: src/ui/settings_page.rs
msgid "Dangerous: May delete files outside target directories"
msgstr "خطير: قد يحذف ملفات خارج المجلدات المستهدفة"

#: src/ui/settings_page.rs
msgid "Appearance"
msgstr "المظهر"

#: src/ui/settings_page.rs
msgid "Color Scheme"
msgstr "نظام الألوان"

#. Help page
#: src/ui/help_page.rs
msgid "Learn how to use Cleaner"
msgstr "تعلم كيفية استخدام المنظف"

#: src/ui/help_page.rs
msgid "About Cleaner"
msgstr "حول المنظف"

#: src/ui/help_page.rs
msgid "Cleaner is a system cleaning utility for Linux that helps you free up disk space by removing temporary files, caches, and other unnecessary data."
msgstr "المنظف هو أداة تنظيف النظام للينكس تساعدك على تحرير مساحة القرص عن طريق إزالة الملفات المؤقتة والذاكرة المؤقتة والبيانات غير الضرورية الأخرى."

