msgid "{used} used, {available} available"
msgstr "{used} σε χρήση, {available} διαθέσιμα"

msgid "Home filesystem could not be detected"
msgstr ""
"Δεν ήταν δυνατός ο εντοπισμός του συστήματος αρχείων του προσωπικού φακέλου"

msgid ""
"This will delete {count} files ({size}).{journal}\n"
"\n"
"This action cannot be undone."
msgstr ""
"Θα διαγραφούν {count} αρχεία ({size}).{journal}\n"
"\n"
"Αυτή η ενέργεια δεν μπορεί να αναιρεθεί."

msgid ""
"\n"
"The archived system journal older than {days} days will also be vacuumed "
"with administrator approval."
msgstr ""
"\n"
"Το αρχειοθετημένο system journal παλαιότερο από {days} ημέρες θα καθαριστεί "
"επίσης με έγκριση διαχειριστή."

msgid ""
"Deleted {count} files and freed {size}.\n"
"{failed} items failed.{journal}"
msgstr ""
"Διαγράφηκαν {count} αρχεία και ελευθερώθηκαν {size}.\n"
"Απέτυχαν {failed} στοιχεία.{journal}"

msgid ""
"\n"
"System journal: {message}."
msgstr ""
"\n"
"System journal: {message}."

msgid ""
"\n"
"System journal failed: {error}"
msgstr ""
"\n"
"Το system journal απέτυχε: {error}"

