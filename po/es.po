#: src/ui/applications_page.rs
msgid ""
"Clean caches from package managers and applications. These are safe to "
"delete but may slow down first runs."
msgstr ""
"Limpiar cachés de gestores de paquetes y aplicaciones. Son seguros de "
"eliminar pero pueden ralentizar las primeras ejecuciones."

#. System page
#: src/ui/system_page.rs
msgid "System Cleanup"
msgstr "Limpieza del sistema"

#: src/ui/system_page.rs
msgid ""
"Clean system-level temporary files and caches. Some options require "
"administrator privileges."
msgstr ""
"Limpiar archivos temporales y cachés a nivel de sistema. Algunas opciones "
"requieren privilegios de administrador."

