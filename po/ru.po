#. Dashboard page
#: src/ui/dashboard_page.rs
msgid "Safe and transparent system cleaning"
msgstr "Безопасная и прозрачная очистка системы"

#: src/ui/dashboard_page.rs
msgid "Reclaimable Space"
msgstr "Освобождаемое пространство"

#: src/ui/dashboard_page.rs
msgid "Enabled Targets"
msgstr "Включенные цели"

#: src/ui/dashboard_page.rs
msgid "Last Cleanup"
msgstr "Последняя очистка"

#: src/ui/dashboard_page.rs
msgid "Never"
msgstr "Никогда"

#: src/ui/dashboard_page.rs
msgid "Start Cleanup"
msgstr "Начать очистку"

#: src/ui/dashboard_page.rs
msgid "Scan and clean enabled targets. You'll see a preview before anything is deleted."
msgstr "Сканировать и очистить включенные цели. Вы увидите предварительный просмотр перед удалением."

#: src/ui/dashboard_page.rs
msgid "Scan for Files"
msgstr "Поиск файлов"

#: src/ui/dashboard_page.rs
msgid "Clean Now"
msgstr "Очистить сейчас"

#: src/ui/dashboard_page.rs
msgid "Scanning..."
msgstr "Сканирование..."

#: src/ui/dashboard_page.rs
msgid "Click 'Scan' to check"
msgstr "Нажмите 'Сканировать' для проверки"

#. Browsers page
#: src/ui/browsers_page.rs
msgid "Browser Cleanup"
msgstr "Очистка браузера"

#: src/ui/browsers_page.rs
msgid "Select which browser data to clean. Cache is safe to delete, but cookies and history are permanent."
msgstr "Выберите какие данные браузера очистить. Кэш безопасно удалять, но куки и история удаляются навсегда."

#: src/ui/browsers_page.rs
msgid "Installed"
msgstr "Установлен"

#: src/ui/browsers_page.rs
msgid "Not detected"
msgstr "Не обнаружен"

#. Browser data types
#: src/ui/browsers_page.rs
msgid "Cache"
msgstr "Кэш"

#: src/ui/browsers_page.rs
msgid "Cookies"
msgstr "Куки"

#: src/ui/browsers_page.rs
msgid "History"
msgstr "История"

#: src/ui/browsers_page.rs
msgid "Sessions"
msgstr "Сессии"

#. Applications page
#: src/ui/applications_page.rs
msgid "Application Caches"
msgstr "Кэш приложений"

#: src/ui/applications_page.rs
msgid "Clean caches from package managers and applications. These are safe to delete but may slow down first runs."
msgstr "Очистить кэш менеджеров пакетов и приложений. Их безопасно удалять, но первый запуск может замедлиться."

#. System page
#: src/ui/system_page.rs
msgid "System Cleanup"
msgstr "Очистка системы"

#: src/ui/system_page.rs
msgid "Clean system-level temporary files and caches. Some options require administrator privileges."
msgstr "Очистить системные временные файлы и кэш. Некоторые опции требуют прав администратора."

#. Settings page
#: src/ui/settings_page.rs
msgid "General"
msgstr "Общие"

#: src/ui/settings_page.rs
msgid "Confirm Before Cleaning"
msgstr "Подтверждать перед очисткой"

#: src/ui/settings_page.rs
msgid "Show a confirmation dialog before deleting files"
msgstr "Показывать диалог подтверждения перед удалением файлов"

#: src/ui/settings_page.rs
msgid "Show Cleanup Summary"
msgstr "Показывать сводку очистки"

#: src/ui/settings_page.rs
msgid "Display a summary after cleaning completes"
msgstr "Отображать сводку после завершения очистки"

#: src/ui/settings_page.rs
msgid "Safety"
msgstr "Безопасность"

#: src/ui/settings_page.rs
msgid "These settings help prevent accidental data loss"
msgstr "Эти настройки помогают предотвратить случайную потерю данных"

#: src/ui/settings_page.rs
msgid "Maximum Files Per Operation"
msgstr "Максимум файлов за операцию"

#: src/ui/settings_page.rs
msgid "Stop after deleting this many files"
msgstr "Остановиться после удаления указанного количества файлов"

#: src/ui/settings_page.rs
msgid "Follow Symlinks"
msgstr "Следовать символическим ссылкам"

#: src/ui/settings_page.rs
msgid "Dangerous: May delete files outside target directories"
msgstr "Опасно: Может удалить файлы за пределами целевых каталогов"

#: src/ui/settings_page.rs
msgid "Appearance"
msgstr "Внешний вид"

#: src/ui/settings_page.rs
msgid "Color Scheme"
msgstr "Цветовая схема"

#. Help page
#: src/ui/help_page.rs
msgid "Learn how to use Cleaner"
msgstr "Узнайте как использовать Cleaner"

#: src/ui/help_page.rs
msgid "About Cleaner"
msgstr "О программе Cleaner"

#: src/ui/help_page.rs
msgid "Cleaner is a system cleaning utility for Linux that helps you free up disk space by removing temporary files, caches, and other unnecessary data."
msgstr "Cleaner — это утилита очистки системы для Linux, которая помогает освободить дисковое пространство путем удаления временных файлов, кэша и других ненужных данных."

